# Settings the pipeline reads. Copy this file to .env and fill in the values.
# .env is gitignored: never commit it, never paste its values anywhere.

# Riot developer portal -> Apps -> your app -> API key
RIOT_API_KEY=

# AWS IAM user lol-crawler (S3 read and write, no delete)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-2

# S3 bucket that holds raw/matches/<match_id>.json
S3_BUCKET=

# Your PUUID. Get it with: uv run python pipeline/lookup_puuid.py "<game name>" "<tag>"
MY_PUUID=

# Optional: new matches per population crawl (default 100)
# MAX_MATCHES=150
